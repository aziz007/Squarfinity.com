# SquarFinity – Apache settings for GoDaddy/cPanel

Options -Indexes
DirectoryIndex index.html

# Force HTTPS once your SSL certificate is active (remove the leading # to enable)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteEngine On
# Real files and folders are served as they are (pages, assets, api/leads.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Anything else goes to the app shell so client-side routes still load
RewriteRule ^ index.html [L]

# Cache static assets for a year (filenames are hashed on each build)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
